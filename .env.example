# Environment Settings
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-spotter-ai-production-grade-key-change-in-prod

# Database Configuration
POSTGRES_DB=spotter_db
POSTGRES_USER=spotter_user
POSTGRES_PASSWORD=spotter_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Cache Configuration
REDIS_URL=redis://localhost:6379/0

# Geospatial Routing API
OPENROUTE_SERVICE_API_KEY=your_openrouteservice_api_key_here
OPENROUTE_SERVICE_BASE_URL=https://api.openrouteservice.org

# CORS Configuration
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
